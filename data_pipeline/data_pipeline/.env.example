# for this we will use minio user name for the aws_access_key_id
aws_access_key_id=admin_user
# we will use minio password for aws_secret_access_key
aws_secret_access_key=super_secret_password
minio_endpoint_url="http://minio:9000"
bucket_name="rag-data"

file_allowed_types=[".txt", ".pdf"]

chunk_size=250
chunk_overlap=50


default_collection_name="my_collection"
